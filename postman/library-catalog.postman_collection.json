      "name": "Authentication",
      "description": "Run Login as librarian before book mutations. Postman retains the httpOnly auth cookie for matching requests.",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman-patron\",\n  \"email\": \"patron@example.com\",\n  \"password\": \"PatronDemo123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
